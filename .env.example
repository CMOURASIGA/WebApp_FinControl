# Produção / desenvolvimento com Supabase real
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA

# Ambiente de demonstração sem banco provisionado.
# Quando true, todo o acesso a dados usa o mock local do 7Finance e a Orion
# responde com dados fictícios do cenário demonstrativo. Nenhuma chamada ao
# Supabase/Postgres real é feita.
# NUNCA habilitar em produção.
VITE_DEMO_MODE=false

# Compatibilidade com previews antigos. Se true, também ativa o modo demo de
# dados e libera autenticação. Prefira VITE_DEMO_MODE nos novos ambientes.
VITE_SKIP_AUTH=false

# A OPENAI_API_KEY é segredo somente da Supabase Edge Function Orion e NÃO deve
# ser criada com prefixo VITE_. Ela não pertence ao bundle do frontend.
