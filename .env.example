# Dados do projeto Supabase (Project Settings → API no painel do Supabase).
# Copie este arquivo para .env.local e preencha antes de rodar `npm run dev`.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA

# Só para as raias de demonstração/desenvolvimento sem Supabase provisionado:
# pula a tela de login e libera o app com um perfil sintético (papel admin).
# NUNCA definir como "true" no ambiente de produção — deixar ausente/false é
# o comportamento padrão e seguro (exige login real).
VITE_SKIP_AUTH=false
